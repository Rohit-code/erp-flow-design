    {
      "id": "NTC5ADGX55t21WzuP0BZ_",
      "type": "text",
      "x": 2289.8956023198193,
      "y": 2019.9067687813379,
      "width": 310.8,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 900012467,
      "version": 2,
      "versionNonce": 868504191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "SI already submitted, so the draft is\nprepared and sent to the customer.\nThey approve or ask for changes —\nloop until approved.\n? Block confirmation if Load Vessel\nisn't recorded yet, or just warn? A\nconfirmed BL for a shut-out container\nis the real risk.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SI already submitted, so the draft is\nprepared and sent to the customer.\nThey approve or ask for changes —\nloop until approved.\n? Block confirmation if Load Vessel\nisn't recorded yet, or just warn? A\nconfirmed BL for a shut-out container\nis the real risk.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CX0_p-ScyUlYTaRA5xpj8",
      "type": "text",
      "x": 1819.895602319819,
      "y": 2019.9067687813379,
      "width": 302.40000000000003,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 900012741,
      "version": 2,
      "versionNonce": 390027505,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "Local tariff (by container type +\ntrade lane) and ocean freight both\nauto-fetch from their Tariff Masters\nat booking/enquiry time. Trade can\nmanually amend for a negotiated or\nregular-customer rate — rare.\nRaised once BL is confirmed and SOB\n(shipped on board) is set.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Local tariff (by container type +\ntrade lane) and ocean freight both\nauto-fetch from their Tariff Masters\nat booking/enquiry time. Trade can\nmanually amend for a negotiated or\nregular-customer rate — rare.\nRaised once BL is confirmed and SOB\n(shipped on board) is set.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-T2r0kXQm85hryYdZik6z",
      "type": "text",
      "x": 1349.895602319819,
      "y": 2019.9067687813379,
      "width": 252,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 900013015,
      "version": 2,
      "versionNonce": 28551839,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "Standing credit with Maxicon —\nno payment needed here.\nOtherwise payment must clear\nbefore the MBL is issued.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Standing credit with Maxicon —\nno payment needed here.\nOtherwise payment must clear\nbefore the MBL is issued.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "yLc2a-ii4G9LqOUX8H-Sm",
      "type": "text",
      "x": 879.8956023198191,
      "y": 2019.9067687813379,
      "width": 277.2,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 900013289,
      "version": 2,
      "versionNonce": 1688802001,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "CONFIRMED — customer choice, made\nat BL-drafting time, not at release:\n- Original BL — physically issued\n- Surrender BL — stamped\n  surrendered, kept in-office",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONFIRMED — customer choice, made\nat BL-drafting time, not at release:\n- Original BL — physically issued\n- Surrender BL — stamped\n  surrendered, kept in-office",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
