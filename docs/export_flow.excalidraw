    {
      "id": "4a0ayegVSZS8C49tSxgD3",
      "type": "text",
      "x": -927.1052315956686,
      "y": -346.86136954171644,
      "width": 707.9795532226562,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
