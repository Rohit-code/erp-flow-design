    {
      "id": "xop8h-R33xYtoVMNYfUAE",
      "type": "text",
      "x": 1589.6149334637598,
      "y": 767.3096241114017,
      "width": 643.0595092773438,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 1915501902,
      "version": 731,
      "versionNonce": 206611790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788459279383,
      "link": null,
      "locked": false,
      "text": "If already the customer exists we have to show him\nthe already saved data he have to select the address.\nat this point user can select multiple address that are present\nin the kyc/kyv saved data only. if he want to add or update \nmake more changes for the order he can just ask the \nsales or anyone to make the changes -> so the admin will \ndo the changes and mail will be received to the customer. \nand everything will be tracked in the order timeline. \nonce kyc/kyv is accpeted, user must select the voyage and vessel",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If already the customer exists we have to show him\nthe already saved data he have to select the address.\nat this point user can select multiple address that are present\nin the kyc/kyv saved data only. if he want to add or update \nmake more changes for the order he can just ask the \nsales or anyone to make the changes -> so the admin will \ndo the changes and mail will be received to the customer. \nand everything will be tracked in the order timeline. \nonce kyc/kyv is accpeted, user must select the voyage and vessel",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
