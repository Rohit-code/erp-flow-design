    {
      "id": "aexf0n-9uQaxYSDgo2lXz",
      "type": "text",
      "x": 409.8956023198191,
      "y": 1292.4067687813379,
      "width": 294,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 900005617,
      "version": 2,
      "versionNonce": 384898193,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "Same evening the yard sends the\nday's out-report: container numbers\nagainst booking numbers. This is\nthe FIRST time Maxicon learns which\ncontainer went to which booking.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same evening the yard sends the\nday's out-report: container numbers\nagainst booking numbers. This is\nthe FIRST time Maxicon learns which\ncontainer went to which booking.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jTOg-VHPgMrXmIu7HpltN",
      "type": "text",
      "x": 1028.0956023198191,
      "y": 1292.4067687813379,
      "width": 6,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 900005891,
      "version": 5,
      "versionNonce": 610763007,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788869233757,
