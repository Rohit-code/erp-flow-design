    },
    {
      "id": "syRRGb2UUgAF-ieBsL7fm",
      "type": "text",
      "x": 1349.895602319819,
      "y": 1292.4067687813379,
      "width": 294,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 900006165,
      "version": 2,
      "versionNonce": 1776441969,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "Customer enters the booking number,\nsees the containers already\nallocated to it, fills in the rest,\nsubmits.\n? Today this submits into Ramco\n(legacy) — replace it, or integrate\nwith Ramco during a transition?",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Customer enters the booking number,\nsees the containers already\nallocated to it, fills in the rest,\nsubmits.\n? Today this submits into Ramco\n(legacy) — replace it, or integrate\nwith Ramco during a transition?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CMNYF75HFeRdmWHvNxFlU",
      "type": "text",
      "x": 1819.895602319819,
      "y": 1292.4067687813379,
      "width": 294,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 900006439,
      "version": 2,
      "versionNonce": 1608220959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788869222156,
      "link": null,
      "locked": false,
      "text": "Container must reach the terminal\ninside the port's own cutoff window\nbefore the vessel — 24-48h,\nport-dependent. Same thing as\n'date in'.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Container must reach the terminal\ninside the port's own cutoff window\nbefore the vessel — 24-48h,\nport-dependent. Same thing as\n'date in'.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
